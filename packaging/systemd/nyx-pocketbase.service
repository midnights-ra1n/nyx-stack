[Unit]
Description=Nyx database (PocketBase)
After=network.target

[Service]
User=nyx
EnvironmentFile=/etc/nyx/server.env
ExecStart=/usr/libexec/nyx/pocketbase serve --http 127.0.0.1:8090 --dir /var/lib/nyx/pb --migrationsDir /usr/share/nyx/pb_migrations
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/nyx

[Install]
WantedBy=multi-user.target
