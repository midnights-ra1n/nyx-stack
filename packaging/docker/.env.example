NYX_VERSION=latest
NYX_MONITOR_URL=https://monitor.example.com
NYX_MANAGER_URL=https://manager.example.com
# Optional Cloudflare relay (docs/cloudflare.md). The URL is the Worker's, the secret
# the Worker's RELAY_SECRET, the key from openssl rand -hex 32. Then set
# NYX_MONITOR_URL to the Worker's address too.
NYX_MONITOR_RELAY_URL=
NYX_MONITOR_RELAY_SECRET=
NYX_MONITOR_RELAY_KEY=
NYX_MANAGER_RELAY_URL=
NYX_MANAGER_RELAY_SECRET=
NYX_MANAGER_RELAY_KEY=
# Only for the db profile. openssl rand -hex 24
NYX_DB_EMAIL=nyx@localhost.invalid
NYX_DB_PASSWORD=
# Only for the agent profile:
NYX_AGENT_URL=
NYX_AGENT_TOKEN=
NYX_AGENT_KEY=
NYX_AGENT_KIND=vm
NYX_AGENT_RELAY_KEY=
# Only for the grafana profile. The token comes from the monitor:
# Settings > Integrations > Grafana. Host and scheme default to the monitor of this file.
NYX_METRICS_TOKEN=
#NYX_METRICS_HOST=monitor.example.com
#NYX_METRICS_SCHEME=https
NYX_METRICS_RETENTION=90d
NYX_GRAFANA_PASSWORD=
