NYX_VERSION=latest
NYX_MONITOR_URL=https://monitor.example.com
NYX_MANAGER_URL=https://manager.example.com
# Only for the db profile. openssl rand -hex 24
NYX_DB_EMAIL=nyx@localhost.invalid
NYX_DB_PASSWORD=
# Only for the agent profile:
NYX_AGENT_URL=
NYX_AGENT_TOKEN=
NYX_AGENT_KEY=
NYX_AGENT_KIND=vm
# Only for the grafana profile. The token comes from the monitor:
# Settings > Integrations > Grafana. Host and scheme default to the monitor of this file.
NYX_METRICS_TOKEN=
#NYX_METRICS_HOST=monitor.example.com
#NYX_METRICS_SCHEME=https
NYX_METRICS_RETENTION=90d
NYX_GRAFANA_PASSWORD=
