{
  "title": "Nyx",
  "uid": "nyx-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "nyx",
    "homelab"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(nyx_host_info, host)",
          "refId": "host"
        },
        "definition": "label_values(nyx_host_info, host)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "refresh": 2,
        "label": "Host"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hosts online",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_hosts_online",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Hosts",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_hosts",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Critical alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_alerts_open{severity=\"crit\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Probe availability (7 d)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_probes_availability_7d_percent",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Power draw",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(nyx_power_watts)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Pending updates",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(nyx_host_updates_pending)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "table",
      "title": "Hosts",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_host_status{host=~\"$host\"}",
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Off",
                  "color": "gray"
                },
                "0": {
                  "text": "OK",
                  "color": "green"
                },
                "1": {
                  "text": "Warning",
                  "color": "orange"
                },
                "2": {
                  "text": "Critical",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "row",
      "title": "Hosts",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_host_cpu_usage_percent{host=~\"$host\"}",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * nyx_host_memory_used_bytes{host=~\"$host\"} / nyx_host_memory_total_bytes",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Network in",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_host_network_receive_bytes_per_second{host=~\"$host\"}",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Network out",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_host_network_transmit_bytes_per_second{host=~\"$host\"}",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Temperature",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_host_temperature_celsius{host=~\"$host\"}",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "type": "bargauge",
      "title": "Disk usage",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * nyx_disk_used_bytes{host=~\"$host\"} / nyx_disk_total_bytes",
          "legendFormat": "{{host}} {{mount}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal"
      }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Disks and containers",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "table",
      "title": "SMART",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_smart_health{host=~\"$host\"}",
          "legendFormat": "",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "nyx_smart_life_left_percent{host=~\"$host\"}",
          "legendFormat": "",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "nyx_smart_temperature_celsius{host=~\"$host\"}",
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "merge"
        }
      ]
    },
    {
      "id": 18,
      "type": "table",
      "title": "Docker containers",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_container_running{host=~\"$host\"}",
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Container CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_container_cpu_usage_percent{host=~\"$host\"}",
          "legendFormat": "{{host}} {{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Proxmox guest CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 47,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_guest_cpu_usage_percent{host=~\"$host\"}",
          "legendFormat": "{{host}} {{guest}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 21,
      "type": "row",
      "title": "Probes",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 22,
      "type": "state-timeline",
      "title": "Probe state",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_probe_up",
          "legendFormat": "{{probe}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Probe latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 62,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_probe_latency_seconds",
          "legendFormat": "{{probe}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 24,
      "type": "bargauge",
      "title": "Certificate expiry",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 62,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_probe_certificate_expiry_days",
          "legendFormat": "{{probe}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal"
      }
    },
    {
      "id": 25,
      "type": "row",
      "title": "Power and Tempo",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 70,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Power by plug",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 71,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_power_watts",
          "legendFormat": "{{plug}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 27,
      "type": "stat",
      "title": "Tempo days left",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 71,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_tempo_days_remaining",
          "legendFormat": "{{colour}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 28,
      "type": "stat",
      "title": "Tempo today / tomorrow",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 71,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nyx_tempo_today",
          "legendFormat": "today: {{colour}}"
        },
        {
          "refId": "B",
          "expr": "nyx_tempo_tomorrow",
          "legendFormat": "tomorrow: {{colour}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "textMode": "name"
      }
    }
  ]
}